<% layout('layouts/boilerplate') %>

<div class="transparent-container white-text py-5">
  <!-- HERO -->
  <div class="container text-center py-5">
    <h1 class="display-4 fw-bold mb-3 gradient-bg animated-gradient">
      Learn Bachata in 1 Hour — Even If You’ve Never Danced Before
    </h1>

    <p class="lead mb-3">
      Finally feel confident dancing — even if you've never stepped on a dance
      floor before.
    </p>

    <p class="fw-bold mb-4 brand-green-text">
      No partner needed • Beginner friendly
    </p>
    <p class="text-warning fw-bold">
      ⚠️ Last class sold out — limited spots available
    </p>
    <a
      href="<%= danceClass.paymentLink %>"
      target="_blank"
      class="btn btn-lg px-5 button-effect"
    >
      Get Class Pass
    </a>
  </div>

  <!-- Testimonials -->
  <div class="container text-center">
    <h2 class="fw-bold mb-4">Join 100+ beginners who started just like you</h2>
    <div class="row g-4 justify-content-center">
      <div class="col-md-4">
        <div class="p-4 border rounded shadow-sm h-100">
          <blockquote class="mb-3">
            “My wife and I have been taking Salsa(on2) with Bryan. We have
            really enjoyed each class. His teaching style really helps you learn
            the steps to each move. We really look forward to continuing classes
            with him each Saturday.”
          </blockquote>
          <h3 class="fw-bold mb-0">— Steve</h3>
          <small class="">The Woodlands, TX</small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-4 border rounded shadow-sm h-100">
          <blockquote class="mb-3">
            “This is my second bachata class and I really like the learning
            dynamics that Bryan uses to teach each step. 100% recommended and I
            will definitely invite more people to come and see the class”
          </blockquote>
          <h3 class="fw-bold mb-0">— Víctor Hugo Yllarramendy</h3>
          <small class="">The Woodlands, TX</small>
        </div>
      </div>
      <div class="col-md-4">
        <div class="p-4 border rounded shadow-sm h-100">
          <blockquote class="mb-3">
            “Excellent teachers, I felt I learned a lot from the very first
            class.”
          </blockquote>
          <h3 class="fw-bold mb-0">— Cynthia Gomez</h3>
          <small class="">The Woodlands, TX</small>
        </div>
      </div>
    </div>
  </div>

  <!-- EVENT DETAILS -->
  <div class="container text-center py-4">
    <div class="card bg-dark text-white border-0 shadow-lg p-4">
      <p class="mb-2">
        <strong>📍 Location:</strong> 25323 I-45, The Woodlands, TX
      </p>
      <p class="mb-2"><strong>📅 Date:</strong> <%= danceClass.date %></p>
      <p class="mb-3"><strong>⏰ Time:</strong> <%= danceClass.time %></p>

      <a
        href="<%= danceClass.paymentLink %>"
        target="_blank"
        class="btn button-effect btn-lg"
      >
        Reserve My Spot
      </a>
    </div>
  </div>

  <!-- WHAT YOU'LL LEARN -->
  <div class="container py-5">
    <h3 class="text-center mb-4">What You'll Learn</h3>

    <div class="row g-4">
      <div class="col-md-6">
        <div class="card bg-dark text-white h-100 p-3">
          The basic steps so you're not lost
        </div>
      </div>

      <div class="col-md-6">
        <div class="card bg-dark text-white h-100 p-3">
          Simple turns you can actually use
        </div>
      </div>

      <div class="col-md-6">
        <div class="card bg-dark text-white h-100 p-3">
          How to lead or follow with confidence
        </div>
      </div>

      <div class="col-md-6">
        <div class="card bg-dark text-white h-100 p-3">
          How to dance with real people at socials
        </div>
      </div>
    </div>
  </div>

  <!-- WHO IT'S FOR -->
  <div class="container py-5">
    <h3 class="text-center mb-4">This Is For You If...</h3>

    <ul class="list-group list-group-flush text-center">
      <li class="list-group-item bg-transparent text-white">
        You've never danced before
      </li>
      <li class="list-group-item bg-transparent text-white">
        You feel like you have "two left feet"
      </li>
      <li class="list-group-item bg-transparent text-white">
        You want to feel confident going out dancing
      </li>
      <li class="list-group-item bg-transparent text-white">
        You've been thinking about trying bachata but haven't started
      </li>
    </ul>
  </div>

  <!-- OBJECTIONS -->
  <div class="container py-5 text-center">
    <h3 class="mb-3">No Experience? No Problem.</h3>

    <p class="mb-3">
      This class is designed for complete beginners. We break everything down
      step-by-step so you can feel comfortable and actually enjoy dancing.
    </p>

    <p class="fw-bold brand-green-text">
      No partner? No problem. You’ll have the option to rotate so you can learn
      faster — but you’re always welcome to stay with your partner.
    </p>
  </div>

  <!-- EMOTIONAL WLAKTHROUGH -->
  <div class="container py-5 text-center">
    <h3>Imagine This...</h3>

    <p>
      You walk in, you hear bachata playing, and instead of sitting down… you
      actually know what to do.
    </p>

    <p class="fw-bold">
      No awkwardness. No overthinking. Just dancing and enjoying yourself.
    </p>
  </div>

  <!-- PRICING -->
  <div class="container py-5 text-center">
    <div class="card bg-dark text-white border-0 shadow-lg p-4">
      <h3 class="mb-3">Pricing</h3>

      <p class="mb-2">
        <strong>Early Bird:</strong> <%= danceClass.promoPrice %> until
        <%=danceClass.promoEnd %>
      </p>
      <p class="mb-3">
        <strong>Regular Price:</strong> <%= danceClass.regularPrice %>
      </p>

      <p class="fw-bold text-warning mb-4">Save $$$ when you book early</p>

      <a
        href="<%= danceClass.paymentLink %>"
        target="_blank"
        class="btn button-effect btn-lg px-5"
      >
        Reserve My Spot Now
      </a>
    </div>
  </div>

  <!-- FINAL CTA -->
  <div class="container text-center py-5">
    <h2 class="mb-3">Last class sold out - don't wait</h2>

    <p class="mb-4">Reserve your spot now and start dancing with confidence.</p>

    <a
      href="<%= danceClass.paymentLink %>"
      target="_blank"
      class="btn button-effect btn-lg px-5"
    >
      Yes, I Want to Learn Bachata
    </a>
  </div>
</div>

<script src="/scripts/trackingBachataCrashCourse.js"></script>
