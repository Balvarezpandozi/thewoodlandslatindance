<% layout('layouts/boilerplate') %>
<div
  class="px-0 py-0 my-0 text-center"
  style="
    background-image: url('../res/images/blogHeroGraphic.jpg');
    background-size: cover;
  "
>
  <div class="py-5 px-4 transparent-container">
    <img
      class="d-block mx-auto mb-4"
      src="/res/images/logo.webp"
      alt="The Woodlands Latin Dance - Event Salsa & Bachata Classes"
      width="200"
      height="200"
    />
    <h1 class="display-5 fw-bold brand-green-text">
      Hire Salsa & Bachata Dance Classes for Your Event
    </h1>
    <div class="col-lg-6 mx-auto white-text">
      <p class="lead mb-4">
        Make your event unforgettable with a fun, interactive Salsa or Bachata
        class. Perfect for corporate events, networking mixers, weddings, and
        private parties — no partner or experience needed!
      </p>
      <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
        <a
          href="#request-quote"
          type="button"
          class="btn btn-success btn-lg px-4 gap-3"
          aria-label="Request a quote for salsa and bachata classes at your event"
        >
          Request a Quote
        </a>
      </div>
      <p class="mt-3 white-text">
        Serving The Woodlands & Greater Houston Area
      </p>
    </div>
  </div>
</div>

<section id="request-quote" class="py-5 bg-light">
  <div class="container">
    <h2 class="fw-bold mb-4 text-center">Request a Quote</h2>
    <p class="lead text-center mb-5">
      Answer a few quick questions so we can give you an accurate quote for your
      event in The Woodlands or Houston, TX.
    </p>

    <div
      id="formMessage"
      class="alert alert-success text-center d-none mb-4 mx-auto"
      role="alert"
      style="width: 100%; max-width: 600px"
    ></div>
    <form
      id="multiStepForm"
      action="/salsa-bachata-event-class"
      method="POST"
      class="mx-auto needs-validation"
      style="max-width: 600px"
      aria-label="Request a quote for salsa and bachata event classes"
      novalidate
    >
      <!-- Step 1 -->
      <div class="form-step">
        <label class="form-label fw-bold" for="eventType"
          >What type of event are you hosting?</label
        >
        <select id="eventType" class="form-select" name="type" required>
          <option selected disabled value="">Select...</option>
          <option>Corporate Event</option>
          <option>Private Party</option>
          <option>Wedding</option>
          <option>Networking Mixer</option>
          <option>Other</option>
        </select>
        <div class="invalid-feedback">Please, select event type.</div>
        <button type="button" class="btn btn-success mt-3 next-btn">
          Next
        </button>
      </div>

      <!-- Step 2 -->
      <div class="form-step d-none">
        <label for="date" class="form-label fw-bold">When is your event?</label>
        <input
          id="date"
          type="date"
          class="form-control"
          name="date"
          required
        />
        <div class="invalid-feedback">Tell us a date estimation.</div>
        <button type="button" class="btn btn-secondary mt-3 prev-btn">
          Previous
        </button>
        <button type="button" class="btn btn-success mt-3 next-btn">
          Next
        </button>
      </div>

      <!-- Step 3 -->
      <div class="form-step d-none">
        <label for="guestCount" class="form-label fw-bold"
          >Approximately how many guests will be there?</label
        >
        <select id="guestCount" class="form-select" name="guestCount" required>
          <option selected disabled value="">Select...</option>
          <option>1–10</option>
          <option>11–20</option>
          <option>21–40</option>
          <option>41+</option>
        </select>
        <div class="invalid-feedback">
          Enter how many guests you are expecting.
        </div>
        <button type="button" class="btn btn-secondary mt-3 prev-btn">
          Previous
        </button>
        <button type="button" class="btn btn-success mt-3 next-btn">
          Next
        </button>
      </div>

      <!-- Step 4 -->
      <div class="form-step d-none">
        <label for="extras" class="form-label fw-bold"
          >Do you also need a venue and/or DJ?</label
        >
        <select id="extras" class="form-select" name="extra" required>
          <option selected disabled value="">Select...</option>
          <option>Only need a venue</option>
          <option>Only need a DJ</option>
          <option>Need both venue and DJ</option>
          <option>Don’t need either</option>
          <option>Not sure yet</option>
        </select>
        <div class="invalid-feedback">Select one option above.</div>
        <button type="button" class="btn btn-secondary mt-3 prev-btn">
          Previous
        </button>
        <button type="button" class="btn btn-success mt-3 next-btn">
          Next
        </button>
      </div>

      <!-- Step 5 -->
      <div class="form-step d-none">
        <label class="form-label fw-bold">Contact Information</label>
        <div class="mb-3">
          <label for="fullName" class="form-label">Full Name</label>
          <input
            type="text"
            id="fullName"
            class="form-control"
            name="fullName"
            placeholder="Full Name"
            required
          />
          <div class="invalid-feedback">Enter your full name.</div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email Address</label>
          <input
            type="email"
            id="email"
            class="form-control"
            name="email"
            placeholder="Email Address"
            required
          />
          <div class="invalid-feedback">Enter a valid email.</div>
        </div>

        <div class="mb-3">
          <label for="phone" class="form-label">Phone Number</label>
          <input
            type="tel"
            id="phone"
            inputmode="tel"
            class="form-control"
            name="phone"
            placeholder="+1(281)202-2058"
            pattern="^\+?[0-9\s\-\(\).]{7,20}$"
            required
          />
          <div class="invalid-feedback">Enter a valid phone number.</div>
        </div>
        <button type="button" class="btn btn-secondary mt-3 prev-btn">
          Previous
        </button>
        <button type="submit" class="btn btn-success mt-3">Submit</button>
      </div>
    </form>
  </div>
</section>

<section class="py-5 bg-light" aria-labelledby="about-heading">
  <div class="container">
    <h2 id="about-heading" class="fw-bold mb-4 text-center">
      About The Woodlands Latin Dance
    </h2>
    <div class="row align-items-center">
      <div class="col-md-5">
        <img
          src="/res/images/aboutus.webp"
          alt="The Woodlands Latin Dance group"
          class="img-fluid rounded shadow"
        />
      </div>
      <div class="col-md-7">
        <p>
          At The Woodlands Latin Dance, we’re more than just instructors — we’re
          a passionate community that celebrates the rhythm and culture of salsa
          and bachata. Our mission is to bring people together through dance,
          creating unforgettable experiences at every event.
        </p>
        <p>
          Whether you’re a first-timer or a seasoned dancer, we design our
          classes to be welcoming, fun, and full of energy. We believe everyone
          deserves to feel the joy of movement and connection, and we’re excited
          to bring that vibe to your next event.
        </p>
        <p>
          Join us and discover why The Woodlands Latin Dance is the go-to choice
          for salsa and bachata classes in the area. Serving The Woodlands, TX,
          and the Greater Houston area, we’re passionate about connecting our
          community through salsa and bachata.
        </p>
      </div>
    </div>
  </div>
</section>

