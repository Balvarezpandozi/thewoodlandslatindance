<% layout('layouts/boilerplate') %>
<div class="container-900px mx-auto my-5 px-5">
  <table class="table">
    <tbody>
      <tr>
        <th scope="row">Name</th>
        <td><%= price.name %></td>
      </tr>
      <tr>
        <th scope="row">Description</th>
        <td><%= price.description %></td>
      </tr>
      <tr>
        <th scope="row">Price</th>
        <td>$<%= price.price %></td>
      </tr>
      <tr>
        <th scope="row">Is Disabled</th>
        <td><%= price.isDisabled %></td>
      </tr>
      <tr>
        <th scope="row">Button Prompt</th>
        <td><%= price.buttonPrompt %></td>
      </tr>
      <tr>
        <th scope="row">Contact for Booking</th>
        <td><%= price.contactBooking %></td>
      </tr>
      <tr>
        <th scope="row">URL</th>
        <td><a href="<%= price.url %>"><%= price.url %></a></td>
      </tr>
      <tr>
        <th scope="row">Position</th>
        <td><%= price.order %></td>
      </tr>
    </tbody>
  </table>
  <a class="btn btn-primary" href="/adminportal">Back to Dashboard</a>
  <a class="btn btn-warning" href="/adminportal/price/edit/<%=price._id%>"
    >Edit</a
  >


  <div class="px-4 py-5 my-0 pricing-container" id="pricing-section">
    <div class="mx-auto" style="max-width: 900px">
      <h1 class="mx-auto text-center display-4">Pricing</h1>
    </div>

    <div
      class="d-flex flex-wrap flex-column flex-md-row justify-content-around mx-auto"
      style="max-width: 900px"
    >
      <div class="card my-2 align-self-stretch flex-grow-1 mx-md-1 mx-auto" style="width: 18rem;">
        <div class="card-body">
          <h2 class="card-title"><%= price.name %> - $<%= price.price %></h2>
          <p class="card-text">
            <%= price.description %>
          </p>
          <% if(!price.contactBooking) { %> 
          <p><strong>💵Payment methods:</strong> <a class="link" target="_blank" href="https://member.life/thewoodlandslatindance/register">SIGN UP</a> and pay with a card online. We also accept cash or Zelle onsite.</p>
          <a target="_blank" href="<%=price.url%>" class="btn <% if(price.isDisabled) { %> disabled disabled-link-text<% } else { %> btn-success <% } %>"><%= price.buttonPrompt %></a>
          <% } else { %>
          <p><strong>💵Payment methods:</strong> Payments are handled onsite (cash, Zelle) or online.</p>
          <button id="contactButton" type="button" data-bs-toggle="modal" data-bs-target="#contactModal" class="btn <% if(price.isDisabled) { %> disabled disabled-link-text<% } else { %> btn-success <% } %>"><%= price.buttonPrompt %></button>
          <div id="contactModal" class="modal" tabindex="-1">
            <div class="modal-dialog" >
              <div class="modal-content text-white" style="background-color: #2b3035"">
                <div class="modal-header">
                  <h5 class="modal-title"><%= price.buttonPrompt %></h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <p>For private lessons, please contact The Woodlands Latin Dance after purchasing to arrange a 1-hour session with an instructor.</p>
                  <a target="_blank" href="<%=price.url%>" class="btn <% if(price.isDisabled) { %> disabled disabled-link-text<% } else { %> btn-success <% } %>"><%= price.buttonPrompt %></a>
                  <p></p>
                  <p>You can call: <i class="fas fa-phone mr-3"></i> <a class="link" href="tel:<%= locals.phoneNumber %>"><%= locals.formattedPhoneNumber %></a></p>
                  <p>You can send a message on <a class="btn btn-outline-light btn-floating m-1" class="text-white" role="button" target="_blank" href="https://www.instagram.com/thewoodlandslatindance/"><i class="fab fa-instagram"></i></a>, <a class="btn btn-outline-light btn-floating m-1" class="text-white" role="button" target="_blank" href="https://www.facebook.com/profile.php?id=61568719342267"><i class="fab fa-facebook-f"></i></a> or <a class="btn btn-outline-light btn-floating m-1" class="text-white" role="button" target="_blank" href="https://wa.me/message/XPUDW3X4DZIDK1"><i class="fab fa-whatsapp"></i></a></p>
                  <p>Or Email us at: <i class="fas fa-envelope mr-3"></i><a class="link" href="mailto:TheWoodlandsLatinDance@gmail.com" target="_blank"> TheWoodlandsLatinDance@gmail.com</a></p>
                  <p>Read our <a class="link" href="/cancellation-policy"> cancellation policy</a> before purchasing.</p>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-success" data-bs-dismiss="modal">Close</button>
                </div>
              </div>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>

