<% layout('layouts/boilerplate') %>
<div class="container-900px mx-auto my-5 px-5">
  <h1 class="mx-auto text-center display-4">All Recipients</h1>
  <a class="btn btn-primary" href="/adminportal">⬅️ Dashboard</a>
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Name <button data-ascending="true" onclick="sortByName(this)" id="name-sort"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 14H2m6-4H2m4-4H2m10 12H2m17 2V4m0 16l3-3m-3 3l-3-3m3-13l3 3m-3-3l-3 3"/></svg></button></th>
        <th scope="col">Email <button data-ascending="true" onclick="sortByEmail(this)" id="email-sort"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 14H2m6-4H2m4-4H2m10 12H2m17 2V4m0 16l3-3m-3 3l-3-3m3-13l3 3m-3-3l-3 3"/></svg></button></th>
        <th scope="col">Status <button data-ascending="true" onclick="sortByStatus(this)" id="status-sort"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 14H2m6-4H2m4-4H2m10 12H2m17 2V4m0 16l3-3m-3 3l-3-3m3-13l3 3m-3-3l-3 3"/></svg></button></th>
      </tr>
    </thead>
    <tbody>
      <% for(let recipient of recipients) { %>
        <tr class="recipient-identifier">
          <td><%= recipient.name %></td>
          <td><%= recipient.email %></td>
          <td>
            <button data-id="<%=recipient._id%>" class="recipientSubscribeButton btn <% if (recipient.subscribed) { %> btn-danger <% } else { %> btn-success <% } %>">
              <% if (recipient.subscribed) { %> Unsubscribe <% } else { %> Subscribe <% } %>
            </button>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<script src="/scripts/allRecipients.js"></script>


