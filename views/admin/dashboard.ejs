<% layout('layouts/boilerplate') %>
<div class="container-900px mx-auto my-5 px-5">
  <h1 class="mx-auto text-center display-4">Dashboard</h1>
  <a class="btn btn-danger" href="/auth/logout">Logout</a> 
  <a class="btn btn-info" href="#">See Website Metrics</a>

  <h2 class="mx-auto display-5">Announcements</h2>
  <a class="btn btn-success" href="/adminportal/announcement/new"
    >New Announcement</a
  >
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Ttile</th>
        <th scope="col">Context</th>
        <th scope="col">Start</th>
        <th scope="col">End</th>
        <th scope="col">---</th>
      </tr>
    </thead>
    <tbody>
      <% for(let announcement of announcements) { %>
        <tr>
          <td><%= announcement.title %></td>
          <td><% if(announcement.positive) { %> Positive <% } else { %> Negative <% } %></td>
          <td><%= announcement.showFrom.toISOString() %></td>
          <td><%= announcement.showUntil.toISOString() %></td>
          <td>
            <form
              action="/adminportal/announcement/<%= announcement.id %>?_method=DELETE"
              method="POST">
              <button class="btn btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <h2 class="mx-auto display-5">Classes</h2>
  <a href="/adminportal/class/new" class="btn btn-success">New Class</a>
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Order</th>
        <th scope="col">Title</th>
        <th scope="col">Day</th>
        <th scope="col">Time</th>
        <th scope="col">---</th>
      </tr>
    </thead>
    <tbody>
      <% for(let danceClass of danceClasses.sort((a,b) => a.order - b.order)) { %>
      <tr>
        <td><%= danceClass.order %></td>
        <td><a href="/adminPortal/class/<%= danceClass._id %>"><%= danceClass.title %></a></td>
        <td><%= danceClass.day %></td>
        <td><%= danceClass.time %></td>
        <td>
          <form
            action="/adminportal/class/<%= danceClass.id %>?_method=DELETE"
            method="POST"
          >
            <button class="btn btn-danger">Delete</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>

  <h2 class="mx-auto display-5">Prices</h2>
  <a class="btn btn-success" href="/adminportal/price/new">New Price</a>
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Price</th>
        <th scope="col">Disabled</th>
        <th scope="col">Require Contact</th>
        <th scope="col">---</th>
      </tr>
    </thead>
    <tbody>
      <% for(let price of prices) { %>
      <tr>
        <td><a href="/adminPortal/price/<%= price._id %>"><%= price.name %></a></td>
        <td>$<%= price.price %></td>
        <td><%= price.isDisabled %></td>
        <td><%= price.contactBooking %></td>
        <td>
          <form
            action="/adminportal/price/<%= price.id %>?_method=DELETE"
            method="POST"
          >
            <button class="btn btn-danger">Delete</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>

  <h2 class="mx-auto display-5">Email Recipients</h2>
  <form
    class="mb-3"
    action="/adminportal/recipients"
    method="POST"
    enctype="multipart/form-data"
  >
  <div class="mb-3">
    <label for="csvFile" class="form-label">Submit list to update recipients</label>
    <input class="form-control" type="file" id="csvFile" name="csvFile" accept=".csv" required />
  </div>
    <button class="btn btn-primary" type="submit">Upload CSV</button>
  </form>
  <p>
    <a class="btn btn-info" href="/adminPortal/recipients">See all email recipients</a>
  </p>
  <a class="btn btn-warning" href="/adminportal/recipeints/getAllRecipients" target="_blank"
    >Get Recipients List</a
  >
</div>
