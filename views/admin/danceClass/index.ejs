<% layout('layouts/boilerplate') %>
<div class="container-900px mx-auto my-5 px-5">
  <table class="table">
    <tbody>
      <tr>
        <th scope="row">Title</th>
        <td><%= danceClass.title %></td>
      </tr>
      <tr>
        <th scope="row">Description</th>
        <td><%= danceClass.description %></td>
      </tr>
      <tr>
        <th scope="row">Day</th>
        <td><%= danceClass.day %></td>
      </tr>
      
      <% danceClass.dates.forEach((dateObject, index) => { %>
      <tr>
        <th scope="row"><% if(index == 0) { %>Dates<% } %></th>
        <td><%= dateObject.month %>: <%= dateObject.dates %></td>
      </tr>
      <% }) %>
      <tr>
        <th scope="row">Time</th>
        <td><%= danceClass.time %></td>
      </tr>
      <tr>
        <th scope="row">Location</th>
        <td><%= danceClass.location %></td>
      </tr>
      <tr>
        <th scope="row">URL</th>
        <td><a href="<%= danceClass.url %>"><%= danceClass.url %></a></td>
      </tr>
      <tr>
        <th scope="row">Button Prompt</th>
        <td><%= danceClass.buttonPrompt %></td>
      </tr>
      <tr>
        <th scope="row">Position</th>
        <td><%= danceClass.order %></td>
      </tr>
    </tbody>
  </table>
  <a class="btn btn-primary" href="/adminportal">Back to Dashboard</a>
  <a class="btn btn-warning" href="/adminportal/class/edit/<%=danceClass._id%>"
    >Edit</a
  >

  <% let danceClasses = [danceClass]; %>

  <div class="px-4 py-5 my-0" id="schedule-section">
    <div class="mx-auto" style="max-width: 900px;">
        <h1 class="mx-auto text-center display-4">Preview</h1>
        <h2 class="mx-auto text-center">Lorem ipsum dolor sit amet consectetur adipisicing elit.</h2>
        <p class="lead">
          Lorem ipsum dolor, sit amet consectetur adipisicing elit. Et quia facere fuga asperiores suscipit itaque architecto illum, incidunt unde provident natus animi, tempore vitae in debitis mollitia ipsa omnis sunt!
        </p>
    </div>

    <div class="d-flex flex-wrap flex-column flex-md-row justify-content-around mx-auto" style="max-width: 900px;">
      <div class="card my-2 align-self-stretch flex-grow-1 mx-md-1 mx-auto" style="width: 18rem;">
        <div class="card-body">
          <h3 class="card-title"><%= danceClass.title %></h3>
          <p class="card-text">
            <%= danceClass.description %>
          </p>
          <p>📅 DAYS: <strong><%= danceClass.day %></strong></p>
          
          <% for(let dateObj of danceClass.dates) { %>
            <p><strong><%= dateObj.month %>: </strong> <%= dateObj.dates %></p>
          <% } %>

          <p>⏰ TIME: <strong><%= danceClass.time %></strong></p>
          <p>📌 LOCATION: <strong><%= danceClass.location %></strong></p>
          <a target="_blank" href="<%= danceClass.url %>" class="btn btn-success"><%= danceClass.buttonPrompt %></a>
        </div>
      </div>
    </div>


    <div class="d-flex flex-wrap flex-column flex-md-row justify-content-around mx-auto" style="max-width: 900px;">
    <% for(let i = 0; i < 2; i++) { %>
      <div class="card my-2 align-self-stretch flex-grow-1 mx-md-1 mx-auto" style="width: 18rem;">
        <div class="card-body">
          <h3 class="card-title"><%= danceClass.title %></h3>
          <p class="card-text">
            <%= danceClass.description %>
          </p>
          <p>📅 DAYS: <strong><%= danceClass.day %></strong></p>
          
          <% for(let dateObj of danceClass.dates) { %>
            <p><strong><%= dateObj.month %>: </strong> <%= dateObj.dates %></p>
          <% } %>

          <p>⏰ TIME: <strong><%= danceClass.time %></strong></p>
          <p>📌 LOCATION: <strong><%= danceClass.location %></strong></p>
          <a target="_blank" href="<%= danceClass.url %>" class="btn btn-success"><%= danceClass.buttonPrompt %></a>
        </div>
      </div>
    <% } %>
    </div>

    <div class="d-flex flex-wrap flex-column flex-md-row justify-content-around mx-auto" style="max-width: 900px;">
    <% for(let i = 0; i < 3; i++) { %>
      <div class="card my-2 align-self-stretch flex-grow-1 mx-md-1 mx-auto" style="width: 18rem;">
        <div class="card-body">
          <h3 class="card-title"><%= danceClass.title %></h3>
          <p class="card-text">
            <%= danceClass.description %>
          </p>
          <p>📅 DAYS: <strong><%= danceClass.day %></strong></p>
          
          <% for(let dateObj of danceClass.dates) { %>
            <p><strong><%= dateObj.month %>: </strong> <%= dateObj.dates %></p>
          <% } %>

          <p>⏰ TIME: <strong><%= danceClass.time %></strong></p>
          <p>📌 LOCATION: <strong><%= danceClass.location %></strong></p>
          <a target="_blank" href="<%= danceClass.url %>" class="btn btn-success"><%= danceClass.buttonPrompt %></a>
        </div>
      </div>
    <% } %>
    </div>
  </div>
</div>