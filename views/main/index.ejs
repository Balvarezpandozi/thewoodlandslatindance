<% layout('layouts/boilerplate') %>
<div class="px-0 py-0 my-0 text-center hero-graphic">
    <div class="py-5 px-4 transparent-container">
        <img class="d-block mx-auto mb-4" src="/res/images/logo.png" alt="The Woodlands Latin Dance Logo" width="200" height="200">
        <h1 class="display-5 fw-bold">The Woodlands Latin Dance</h1>
        <div class="col-lg-6 mx-auto">
          <p>Salsa and Bachata classes in The Woodlands, TX</p>
          <p class="lead mb-4">Dance with passion 🔥, connect with culture 🎊 at The Woodlands Latin Dance</p>
          <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a target="_blank" href="https://member.life/thewoodlandslatindance/register" type="button" class="btn btn-success btn-lg px-4 gap-3">Sign Up Here!</a>
          </div>
        </div>
    </div>
</div>

<div class="px-4 py-5 my-0" id="schedule-section">
    <div class="container-900px mx-auto">
        <h1 class="mx-auto text-center display-4">Dance Class Schedule</h1>
        <h2 class="mx-auto text-center">Salsa and Bachata classes in The Woodlands</h2>
        <p class="lead">
          Classes are held weekly, four times a month, following a progressive structure. Each week builds on the last, 
          ensuring steady improvement. At the end of the four-week cycle, the series resets, making it easy to join at any time.
        </p>
    </div>

    <div class="d-flex flex-wrap flex-column flex-md-row justify-content-around container-900px mx-auto">
    <% for(let danceClass of danceClasses) { %>
      <div class="card my-2 align-self-stretch mx-auto" style="width: 18rem;">
        <div class="card-body">
          <h3 class="card-title"><%= danceClass.title %></h3>
          <p class="card-text">
            <%= danceClass.description %>
          </p>
          <p>📅 DAYS: <strong><%= danceClass.day %></strong></p>
          
          <% for(let dateObj of danceClass.dates) { %>
            <p><strong><%= dateObj.month %>: </strong> <%= dateObj.dates %></p>
          <% } %>

          <p>⏰ TIME: <strong><%= danceClass.time %></strong></p>
          <p>📌 LOCATION: <strong><%= danceClass.location %></strong></p>
          <a target="_blank" href="https://member.life/thewoodlandslatindance/calendar" class="btn btn-success">Check out details</a>
        </div>
      </div>
    <% } %>
  </div>
</div>

<div class="px-4 py-5 my-0 pricing-container" id="pricing-section">
  <div class="container-900px mx-auto">
      <h1 class="mx-auto text-center display-4">Pricing</h1>
  </div>
  <div class="d-flex flex-wrap flex-column flex-md-row justify-content-around container-900px mx-auto">
    <% for(let price of prices) { %>
    <div class="card my-2 align-self-stretch flex-grow-1 mx-1" style="width: 18rem;">
      <div class="card-body">
        <h2 class="card-title"><%= price.name %> - $<%= price.price %></h2>
        <p class="card-text">
          <%= price.description %>
        </p>
        <% if(!price.contactBooking) { %> 
        <p><strong>💵Payment methods:</strong> <a class="link" target="_blank" href="https://member.life/thewoodlandslatindance/register">SIGN UP</a> and pay with a card online. We also accept cash or Zelle onsite.</p>
        <a target="_blank" href="https://member.life/thewoodlandslatindance/register" class="btn <% if(price.isDisabled) { %> disabled disabled-link-text<% } else { %> btn-success <% } %>"><%= price.buttonPrompt %></a>
        <% } else { %>
        <p><strong>💵Payment methods:</strong> Payments are handled onsite (cash, Zelle) or online.</p>
        <button id="contactButton" type="button" data-bs-toggle="modal" data-bs-target="#contactModal" class="btn <% if(price.isDisabled) { %> disabled disabled-link-text<% } else { %> btn-success <% } %>">Contact The Woodlands Latin Dance</button>
        <div id="contactModal" class="modal" tabindex="-1">
          <div class="modal-dialog" >
            <div class="modal-content text-white" style="background-color: #2b3035"">
              <div class="modal-header">
                <h5 class="modal-title">Contact The Woodlands Latin Dance</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <p>For private lessons, please contact The Woodlands Latin Dance to arrange a 1-hour session with an instructor.</p>
                <p>You can call: <i class="fas fa-phone mr-3"></i> <a class="link" href="tel:<%= locals.phoneNumber %>"><%= locals.formattedPhoneNumber %></a></p>
                <p>You can send a message on <a class="btn btn-outline-light btn-floating m-1" class="text-white" role="button" target="_blank" href="https://www.instagram.com/thewoodlandslatindance/"><i class="fab fa-instagram"></i></a>, <a class="btn btn-outline-light btn-floating m-1" class="text-white" role="button" target="_blank" href="https://www.facebook.com/profile.php?id=61568719342267"><i class="fab fa-facebook-f"></i></a> or <a class="btn btn-outline-light btn-floating m-1" class="text-white" role="button" target="_blank" href="https://wa.me/message/XPUDW3X4DZIDK1"><i class="fab fa-whatsapp"></i></a></p>
                <p>Or Email us at: <i class="fas fa-envelope mr-3"></i><a class="link" href="mailto:TheWoodlandsLatinDance@gmail.com" target="_blank"> TheWoodlandsLatinDance@gmail.com</a></p>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">Close</button>
              </div>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<div class="px-4 py-5 my-0 faqs-container" id="faqs-section">
  <div class="container-900px mx-auto">
      <h1 class="mx-auto text-center display-4">Frequently Asked Questions (FAQs)</h1>
  </div>
  <div class="container-900px mx-auto">
      <div class="question-shadow p-2">
        <a class="question" data-bs-toggle="collapse" href="#q1" role="button", aria-expanded="false" aria-controls="q1">🕺🏻 Can I... just show up?</a>
        <div class="collapse" id="q1">
          <p>Absolutely! Check out our schedule and come to the class of your choice.</p>
        </div>
      </div>
      <div class="question-shadow p-2">
        <a class="question" data-bs-toggle="collapse" href="#q2" role="button", aria-expanded="false" aria-controls="q1">💃🏻 What do I wear?</a>
        <div class="collapse" id="q2">
          <p>Athletic clothes that allow full range of motion and make you feel comfortable. Well-fitting sneakers or flats work great. Dance shoes or heels are optional—let’s get you started before investing in special footwear.</p>
        </div>
      </div>
      <div class="question-shadow p-2">
        <a class="question" data-bs-toggle="collapse" href="#q3" role="button", aria-expanded="false" aria-controls="q3">🕺🏻 Do I need a partner?</a>
        <div class="collapse" id="q3">
          <p>No partner is required for any of the classes. We rotate leads and follows so everyone has a chance to practice.</p>
        </div>
      </div>
      <div class="question-shadow p-2">
        <a class="question" data-bs-toggle="collapse" href="#q4" role="button", aria-expanded="false" aria-controls="q4">💃🏻 How do I register for classes?</a>
        <div class="collapse" id="q4">
          You can register in advance online by visiting 
          <a class="link" target="_blank" href="https://member.life/thewoodlandslatindance/register">our registration page</a>. 
          If you prefer, you can also just show up, and we’ll take care of everything at the door!
        </div>
      </div>
  </div>
</div>

<script>
  const myModal = document.getElementById('contactModal')
  const myInput = document.getElementById('contactButton')

  myModal.addEventListener('shown.bs.modal', () => {
    myInput.focus()
  });
</script>