<!-- Remove the container if you want to extend the Footer to full width. -->
<div id="contact-section">
  <!-- Footer -->
  <footer
    class="text-center text-lg-start text-white"
    style="background-color: #2b3035"
  >
    <!-- Grid container -->
    <div class="container p-4 pb-0">
      <!-- Section: Links -->
      <section class="">
        <!--Grid row-->
        <div class="row">
          <!-- Grid column -->
          <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3">
            <h2 class="text-uppercase mb-4 font-weight-bold">
              The Woodlands Latin Dance
            </h2>
            <p>Dance with passion 🔥, connect with culture 🎊</p>
            <a class="link" href="/salsa-bachata-event-class"
              >Hire Us for Your Event</a
            >
          </div>
          <!-- Grid column -->

          <hr class="w-100 clearfix d-md-none" />

          <!-- Grid column -->
          <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mt-3">
            <h3 class="text-uppercase mb-4 font-weight-bold">Useful links</h3>
            <p>
              <a class="text-white" href="<%= locals.scheduleLink %>"
                >Schedule</a
              >
            </p>
            <p>
              <a class="text-white" href="<%= locals.pricingLink %>">Pricing</a>
            </p>
            <p>
              <a class="text-white" href="<%= locals.studentResourcesLink %>"
                >Student Resources</a
              >
            </p>
            <p>
              <a class="text-white" href="<%= locals.faqsLink %>">FAQs</a>
            </p>
          </div>

          <!-- Grid column -->
          <hr class="w-100 clearfix d-md-none" />

          <!-- Grid column -->
          <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mt-3">
            <h3 class="text-uppercase mb-4 font-weight-bold">Contact</h3>
            <p>
              <i class="fas fa-home mr-3"></i> 25323 I-45, The Woodlands, TX
              77380
            </p>
            <p>
              <i class="fas fa-envelope mr-3"></i>
              <a class="link" href="mailto:TheWoodlandsLatinDance@gmail.com"
                >TheWoodlandsLatinDance@gmail.com</a
              >
            </p>
            <p>
              <i class="fas fa-phone mr-3"></i>
              <a class="link" href="tel:<%= locals.phoneNumber %>"
                ><%= locals.formattedPhoneNumber %></a
              >
            </p>
          </div>
          <!-- Grid column -->
        </div>
        <!--Grid row-->
      </section>
      <!-- Section: Links -->

      <hr class="my-3" />

      <!-- Section: Copyright -->
      <section class="p-3 pt-0">
        <div class="row d-flex align-items-center">
          <!-- Grid column -->
          <div class="col-md-7 col-lg-8 text-center text-md-start">
            <!-- Copyright -->
            <div class="p-3">The Woodlands Latin Dance © 2024 Copyright</div>
            <!-- Copyright -->
          </div>
          <!-- Grid column -->

          <!-- Grid column -->
          <div class="col-md-5 col-lg-4 ml-lg-0 text-center text-md-end">
            <!-- Facebook -->
            <a
              aria-label="link to The Woodlands latin Dance Facebook page"
              class="btn btn-outline-light btn-floating m-1"
              class="text-white"
              role="button"
              target="_blank"
              href="https://www.facebook.com/profile.php?id=61568719342267"
              ><i class="fab fa-facebook-f"></i
            ></a>

            <!-- Instagram -->
            <a
              aria-label="link to The Woodlands latin Dance Instagram page"
              class="btn btn-outline-light btn-floating m-1"
              class="text-white"
              role="button"
              target="_blank"
              href="https://www.instagram.com/thewoodlandslatindance"
              ><i class="fab fa-instagram"></i
            ></a>

            <!-- Whatsapp -->
            <a
              aria-label="link to The Woodlands latin Dance Whatsapp"
              class="btn btn-outline-light btn-floating m-1"
              class="text-white"
              role="button"
              target="_blank"
              href="https://wa.me/message/XPUDW3X4DZIDK1"
              ><i class="fab fa-whatsapp"></i
            ></a>

            <!-- TikTok -->
            <a
              aria-label="link to The Woodlands latin Dance TikTok page"
              class="btn btn-outline-light btn-floating m-1"
              class="text-white"
              role="button"
              target="_blank"
              href="https://www.tiktok.com/@thewoodlandslatindance?_t=ZT-8slz0DowjPv&_r=1"
              ><i class="fab fa-tiktok"></i
            ></a>
          </div>
          <!-- Grid column -->
        </div>
      </section>
      <!-- Section: Copyright -->
    </div>
    <!-- Grid container -->
  </footer>
  <!-- Footer -->
</div>
<!-- End of .container -->
